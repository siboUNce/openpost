# Copy this file to S:\OpenPost\.env and replace only the secret placeholders.
# Never commit the real .env file.

OPENPOST_APP_URL=https://post.saivareeclinic.com
OPENPOST_PUBLIC_URL=https://post.saivareeclinic.com
OPENPOST_MEDIA_URL=https://post.saivareeclinic.com/media

OPENPOST_JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
OPENPOST_ENCRYPTION_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET

OPENPOST_DISABLE_REGISTRATIONS=true
OPENPOST_DISABLE_TIKTOK_DISPLAY_API=true

# Runtime image used by docker-compose.yml.
OPENPOST_IMAGE=saivaree/openpost:current-main-e031fba
